# Database
# For local development: file:./data/mocap.db
# For Turso (recommended for Vercel): libsql://your-db.turso.io
TURSO_DATABASE_URL=file:./data/mocap.db
TURSO_AUTH_TOKEN=your-turso-auth-token

# Slack Webhook URL (optional - for notifications)
# Get this from your Slack workspace: Apps > Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Public app URL (for Slack links)
# Will be set after Vercel deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
